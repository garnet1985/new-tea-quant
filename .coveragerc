[run]
# Default suite is core/infra + core/modules (see pytest.ini).
source = core
omit =
    */__test__/*
    */__performance__/*
    */__pycache__/*
    */venv/*
    */userspace/*
    */test_*.py
    */__init__.py
    */example.py
    */*_example.py
    # Not in default pytest suite (norecursedirs); keep coverage denominator honest
    */core/ui/*
    */core/bff/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
