########################
# Virtual Environment
########################

.venv
venv/
test-venv/
env/
ENV/
env.bak/
venv.bak/

# Live userspace at repo root only. Do not use a bare `userspace/` —
# that also ignores the install template under setup steps.
/userspace/
# 安装/实验时挪开的 userspace 备份（如 userspace._bak_install_20261113_151122）
/userspace._bak*/

# Pack scratch under setup init_userspace assets（`devcli pu` 生成；zip/meta/README 仍跟踪）
core/infra/setup/core/steps/init_userspace/assets/userspace/

