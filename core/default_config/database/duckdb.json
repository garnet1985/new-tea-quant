{
  "domains": {
    "data": {
      "db_path": "data.duckdb"
    },
    "tag": {
      "db_path": "tag.duckdb"
    },
    "strategy": {
      "db_path": "strategy.duckdb"
    }
  },
  "threads": 4,
  "memory_limit": "8GB",
  "wal_autocheckpoint": "4MB",
  "checkpoint_after_batch_save": true,
  "checkpoint_on_sigint": true,
  "checkpoint_after_persist": false,
  "_comment": "DuckDB 三存储域，文件位于 userspace/system/db/；wal_autocheckpoint/checkpoint_* 控制 WAL 合并频率"
}
