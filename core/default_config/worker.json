{
  "job_pipeline": {
    "_comment": "BE 调度配置（ProcessPool / entities_per_job 等）；策略/Tag settings 不可覆盖。default 为兜底；各 profile 可设 reserve_cores / max_parallel_jobs_cap / dispatch / calendar_slice。用户可在 userspace/config/worker.json 用相同结构覆盖。代码 fallback：backtest_engine.performance.worker_profile.constants",
    "default": {
      "reserve_cores": 1,
      "max_parallel_jobs_cap": null
    },
    "enumerator": {
      "reserve_cores": 2,
      "max_workers": "auto",
      "_comment_dispatch": "entities_per_job 等见 dispatch；代码 fallback 见 backtest_engine.performance.worker_profile.constants",
      "calendar_slice": {
        "reader_workers": "auto",
        "queue_depth": "auto",
        "prefetch_enabled": true
      },
      "dispatch": {
        "memory_budget_mb": "auto",
        "memory_floor_mb": "auto",
        "warmup_batch_size": "auto",
        "min_batch_size": "auto",
        "max_batch_size": "auto",
        "monitor_interval": 5,
        "entities_per_job": "auto",
        "dispatch_probe": true,
        "entities_per_job_auto_target": 20,
        "entities_per_job_min": 20,
        "entities_per_job_max": 100
      }
    },
    "tag": {
      "reserve_cores": 1,
      "max_parallel_jobs_cap": null,
      "_comment": "Tag SOT：与 enumerator 同构（dispatch=entity_based，calendar_slice=slice_based）",
      "dispatch": {
        "dispatch_probe": true,
        "entities_per_job": "auto",
        "entities_per_job_min": 1,
        "entities_per_job_max": 500,
        "memory_floor_mb": "auto"
      },
      "calendar_slice": {
        "reader_workers": "auto",
        "queue_depth": "auto",
        "prefetch_enabled": true,
        "slice_open_days": "auto"
      }
    },
    "price_factor": {
      "reserve_cores": 1,
      "max_parallel_jobs_cap": null,
      "dispatch": {
        "entities_per_job": 1000,
        "dispatch_probe": false
      }
    },
    "scanner": {
      "reserve_cores": 1,
      "max_parallel_jobs_cap": null,
      "dispatch": {
        "entities_per_job": "auto",
        "entities_per_job_auto_target": 50,
        "entities_per_job_min": 20,
        "entities_per_job_max": 200,
        "dispatch_probe": true
      }
    }
  }
}
