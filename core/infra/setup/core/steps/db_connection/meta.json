{
  "id": "db_connection",
  "name": "数据库配置",
  "description": "选择和配置您所使用的数据库。",
  "scriptEntry": "core/infra/setup/core/steps/db_connection/install.py",
  "requiresUserInput": true,
  "inputSchema": [
    {
      "key": "dbType",
      "label": "数据库类型",
      "type": "select",
      "required": true,
      "defaultValue": "duckdb",
      "options": [
        {
          "label": "DuckDB（推荐，本地文件）",
          "value": "duckdb"
        },
        {
          "label": "PostgreSQL（远程/自建）",
          "value": "postgresql"
        },
        {
          "label": "MySQL（远程/自建）",
          "value": "mysql"
        }
      ]
    },
    {
      "key": "host",
      "label": "主机地址",
      "type": "text",
      "required": false
    },
    {
      "key": "port",
      "label": "端口",
      "type": "text",
      "required": false
    },
    {
      "key": "database",
      "label": "数据库名称",
      "type": "text",
      "required": false
    },
    {
      "key": "user",
      "label": "用户名",
      "type": "text",
      "required": false
    },
    {
      "key": "password",
      "label": "密码",
      "type": "password",
      "required": false
    },
    {
      "key": "defaultPgsqlSchema",
      "label": "数据库模式",
      "type": "text",
      "required": false
    }
  ],
  "retryPolicy": {
    "mode": "input_required_on_failure"
  },
  "dependencies": [
    "init_userspace"
  ],
  "order": 4,
  "progressWeight": 8,
  "uiVisible": true
}
