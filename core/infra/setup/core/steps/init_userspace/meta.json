{
  "id": "init_userspace",
  "name": "初始化用户空间",
  "description": "用户空间用来存放你的策略、数据和配置。一般保持默认路径即可。",
  "scriptEntry": "core/infra/setup/core/steps/init_userspace/install.py",
  "requiresUserInput": true,
  "inputSchema": [
    {
      "key": "userspaceTargetPath",
      "label": "用户空间路径",
      "type": "text",
      "required": false,
      "defaultValue": "",
      "placeholder": "默认使用项目根目录下的用户空间文件夹",
      "helperText": "默认使用下方绝对路径；仅在需要换盘或共享目录时再自定义。",
      "editableByCheckbox": true,
      "editableLabel": "我想自定义用户空间路径"
    },
    {
      "key": "userspaceConflictPolicy",
      "label": "目标路径已存在时",
      "type": "select",
      "required": true,
      "defaultValue": "skip",
      "options": [
        {
          "label": "跳过（保留当前用户空间）",
          "value": "skip"
        },
        {
          "label": "覆盖（删除原来的用户空间目录，重新创建）",
          "value": "overwrite"
        }
      ]
    }
  ],
  "retryPolicy": {
    "mode": "input_required_on_failure"
  },
  "dependencies": [
    "resolve_deps"
  ],
  "order": 3,
  "progressWeight": 8,
  "uiVisible": true
}
