      "requirements.in",
      "requirements.txt",
      "ROADMAP.md",
      "SECURITY.md",
      "cli.py",
      "devcli.py",
      "SUPPORT.md",
      "initialization"
    ],
    "update_ignored_paths": [
      "userspace",
      "initialization/data"
    ]
  }
}
