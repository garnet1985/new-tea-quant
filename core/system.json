{
  "version": "0.5.1",
  "release_date": "2026-09-23",
  "description": "版本发布",
  "python": {
    "minimum": [
      3,
      9
    ]
  },
  "new_features": [
    "修改安装数据导入步骤的底层逻辑，不再有python对象的转化，从而提高了至少10倍速度",
    "改进了安装过程中的打包依赖判断，现在如果发现是国内就使用镜像，大大增加安装速度",
    "给决策者模式的每次投资加入笔记的功能，在回溯日历里能看到当时的笔记",
    "修复了userspace不在项目根目录下的种种问题",
    "将cli从infra放入modules内",
    "对策略（strategy）和标签（tag）模块加入过滤样本清单的钩子函数",
    "所有核心模块的声明多了包package字段",
    "重新打包用户空间，大幅度简化示例代码，降低理解难度"
  ],
  "update_plan": {
    "managed_scope": [
      ".github",
      "core",
      "ci",
      "docs",
      ".gitignore",
      ".dockerignore",
      "CHANGELOG.md",
      "CODE_OF_CONDUCT.md",
      "CONTRIBUTING.md",
      "DISCLAIMER.md",
      "docker-compose.yml",
      "Dockerfile",
      "install.py",
      "launcher.py",
      "LICENSE",
      "pytest.ini",
      "README_en.md",
      "README.md",
      "requirements-dev.in",
      "requirements-dev.txt",
      "requirements.in",
      "requirements.txt",
      "ROADMAP.md",
      "SECURITY.md",
      "cli.py",
      "devcli.py",
      "SUPPORT.md",
      "initialization"
    ],
    "update_ignored_paths": [
      "userspace",
      "initialization/data"
    ]
  }
}
